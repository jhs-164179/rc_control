<?xml version="1.0" encoding="UTF-8"?>
<!--
  cyclonedds.xml — 컨테이너/머신 간 DDS discovery 설정

  사용:
    export CYCLONEDDS_URI=file:///workspace/cyclonedds.xml

  같은 호스트의 컨테이너끼리(host 네트워크 모드) 또는 같은 유선 LAN 이면
  이 파일 없이 기본 멀티캐스트로도 붙는다. 이 파일은 다음 경우에 필요하다:
    - Wi-Fi 나 기관 네트워크에서 멀티캐스트가 막혀 있을 때
    - 인터페이스가 여러 개라(유선, 무선, docker0) 자동 판별이 엉뚱한 걸 고를 때

  아래 Peer address 를 상대 장비 IP 로 바꿀 것. 자기 IP 가 아니라 상대 IP 다.
  양쪽에 서로를 가리키도록 넣는다.
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">

    <General>
      <!-- 인터페이스를 명시하려면 name 을 쓴다. 예: name="wlan0" / name="eth0"
           확실하지 않으면 autodetermine 을 그대로 둔다. -->
      <Interfaces>
        <NetworkInterface autodetermine="true" priority="default" multicast="default"/>
      </Interfaces>

      <!-- 유니캐스트 discovery 를 쓸 때는 false 로 둔다. -->
      <AllowMulticast>false</AllowMulticast>
      <MaxMessageSize>65500B</MaxMessageSize>
    </General>

    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <Peers>
        <Peer address="localhost"/>
        <Peer address="192.168.0.7"/>
      </Peers>
    </Discovery>

    <!-- [261017] Internal/EnableExpensiveChecks 항목 제거. 'false' 는 유효한 값이 아니라(whc|rhc|all 만 받음)
         libddsc 0.10 이 설정 파싱에 실패해 이 파일을 쓰는 모든 노드의 domain 생성이 실패했다. -->

    <!-- 문제 진단 시에는 verbosity 를 config 또는 fine 으로 올린다 -->
    <Tracing>
      <Verbosity>warning</Verbosity>
      <OutputFile>stderr</OutputFile>
    </Tracing>

  </Domain>
</CycloneDDS>