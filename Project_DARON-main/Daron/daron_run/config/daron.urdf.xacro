<?xml version="1.0"?>
<!--
  DARON 로버 URDF   v0.2   2026-09-01  이지홍

  [좌표계 규약]
    REP-103 : x=전방, y=좌, z=상 / 단위 m, rad
    REP-105 : map -> odom -> base_link

  [base_link 정의]  (2026-09-01 확정)
    후면부에서 롤 회전 축과 두 바퀴를 잇는 라인이 만나는 교점.
    카메라와 CV7이 모두 후면부에 고정되어 있으므로,
    굴절각·롤각이 변해도 이 세 요소의 상대 위치는 불변.

  [의도적으로 넣지 않은 것]
    - 굴절 관절 / 전면부 : 9/15 이후 CVPR 기여1(기하 마스킹)에서 추가
    - 롤 관절 / 바퀴     : 현재 EKF에 불필요
    - camera_link -> camera_*_optical_frame : realsense-ros가 자동 발행.
                                              여기서 정의하면 이중 발행이 됨

  [현재 상태]
    카메라(cam_*) : 준서님 CAD 실측값 반영 (2026-09-02).
    CV7(imu_*)    : 위치 미수령이라 0 (placeholder).
    [261008] 자세는 mount 인자로 선택 — 기본 level(설계: 두 센서 완전 수평), cad0902(옛 값, 옛 bag 재생용).
    launch(daron_viz) 가 mount 를 넘기고, 생성된 URDF 에서 같은 값을 읽어 SLAM 노드·IMU 릴레이에 준다.

  [사용법]
    xacro daron.urdf.xacro > daron.urdf
    check_urdf daron.urdf
    ros2 run robot_state_publisher robot_state_publisher daron.urdf
    ros2 run tf2_tools view_frames
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="daron">

  <!-- ==========================================================
       실측 파라미터   (준서님 CAD 기준)
       CAD에서 mm/deg로 받으므로 여기서 m/rad로 변환해 적는다.
       예) 250mm -> 0.25 / 15deg -> 0.2618
       ========================================================== -->

  <!-- base_link 기준 D405 장착 위치 [m]
       출처   : 준서님 Fusion 측정, 2026-09-02
       기준점 : base_link = 후면부 롤축 x 두 바퀴 라인 교점
       주의   : 측정 기준점이 카메라 본체 앞면 중앙임.
                realsense-ros의 camera_link 정의 지점과 다를 수 있어
                오프셋 보정 필요. 내일 tf2_echo로 대조 예정. -->
  <xacro:property name="cam_x"     value="0.244427"/>  <!-- CAD 244.427 mm -->
  <xacro:property name="cam_y"     value="0.0"/>       <!-- CAD -4.473e-09 mm, 사실상 0 -->
  <xacro:property name="cam_z"     value="0.034352"/>  <!-- CAD 34.352 mm -->
  <!-- [261008] 장착 자세 세트 선택: xacro daron.urdf.xacro mount:=level|cad0902
       level   (기본) 실물 로버 장착값. [261016] calib_261016(평지 정지) + calib_261016_2(제자리 360° 좌·우,
               경사)에서 추정 — 제자리 회전축(=차체 z)·중력·depth 바닥면·자이로–SLAM 상대회전.
               두 센서 다 차체 대비 앞이 약 9° 들림, 카메라↔IMU 는 1° 안으로 평행. 정확도 약 ±1°.
               yaw 는 이 bag 으로 못 잼(0 유지). 261016 이전 설계값은 rpy 0 (git 이력).
       cad0902 9/2 CAD·임시값(카메라 pitch -8°, IMU -1.5°/-17.4°). 그 시기 bag 재생용.
       위치(cam_x/y/z)는 두 세트 공통(CAD 실측). -->
  <xacro:arg name="mount" default="level"/>
  <xacro:property name="mount" value="$(arg mount)"/>
  <xacro:if value="${mount not in ['level', 'cad0902']}">
    <xacro:ERROR_mount_must_be_level_or_cad0902/>
  </xacro:if>

  <!-- D405 장착 자세 [rad]
       (REP-103에서 pitch 양수 = 코가 아래로 내려감) -->
  <xacro:property name="cam_roll"  value="${0.0 if mount == 'cad0902' else -0.017}"/>       <!-- level: -1.0° -->
  <xacro:property name="cam_pitch" value="${-0.13963 if mount == 'cad0902' else -0.150}"/>  <!-- cad0902: CAD 8도 위 / level: -8.6° (261016) -->
  <xacro:property name="cam_yaw"   value="0.0"/>

  <!-- TODO(준서님): base_link 기준 CV7 장착 위치 [m] — CAD 미수령. 계산에는 안 쓰임
       (EKF 는 IMU 자세·각속도만 쓰고 레버암 보정 없음, VIO 미사용). -->
  <xacro:property name="imu_x"     value="0.0"/>
  <xacro:property name="imu_y"     value="0.0"/>
  <xacro:property name="imu_z"     value="0.0"/>
  <!-- CV7 장착 자세 [rad]. 축은 REP-103 (cv7 yml use_enu_frame: True). -->
  <xacro:property name="imu_roll"  value="${-0.02625 if mount == 'cad0902' else 0.016}"/>   <!-- level: +0.9° (261016) -->
  <xacro:property name="imu_pitch" value="${-0.30395 if mount == 'cad0902' else -0.161}"/>  <!-- level: -9.2° (261016) -->
  <xacro:property name="imu_yaw"   value="0.0"/>


  <!-- ==========================================================
       링크 (강체)
       ========================================================== -->

  <!-- 로버 기준점. odom -> base_link 는 EKF가 발행하므로 여기서 다루지 않는다. -->
  <link name="base_link"/>

  <!-- D405 본체 -->
  <link name="camera_link"/>

  <!-- CV7 INS -->
  <link name="imu_link"/>


  <!-- ==========================================================
       조인트 (링크 간 관계)
       ========================================================== -->

  <!-- 카메라는 후면부에 고정 (2026-09-01 확인). 주행 중 상대 위치 불변. -->
  <joint name="base_to_camera" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="${cam_x} ${cam_y} ${cam_z}"
            rpy="${cam_roll} ${cam_pitch} ${cam_yaw}"/>
  </joint>

  <!-- CV7도 후면부에 고정 (2026-09-01 확인). -->
  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_z}"
            rpy="${imu_roll} ${imu_pitch} ${imu_yaw}"/>
  </joint>

</robot>
