# RADXA 원격 기동 접속 정보 — Daron/daron_run/tools/radxa_up.sh 가 읽는다.
# 이 파일을 같은 폴더에 radxa.env 로 복사해 채운다. radxa.env 는 git 에 올라가지 않는다.
#   cp secrets/radxa.env.example secrets/radxa.env && chmod 600 secrets/radxa.env
# bash 로 source 되므로 특수문자가 든 값은 작은따옴표로 감싼다:  RADXA_SSH_PASS='p@ss$word'

RADXA_HOST=
RADXA_USER=

# ssh 비밀번호. 비워 두면 키 인증(ssh-copy-id 권장)이거나, 기동할 때 한 번만 직접 입력한다
# (첫 접속을 4개 창이 같이 쓰므로 한 번이면 된다). 채우면 sshpass 가 필요: sudo apt install sshpass
RADXA_SSH_PASS=

DOCKER_CONTAINER=
ROVER_DIR=
SUSP_PROFILE=profiles/rover.json